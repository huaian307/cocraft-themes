{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cocraft theme.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "author",
    "version",
    "mode"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "preview": {
      "type": "string"
    },
    "css": {
      "type": "string"
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "background": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string"
        },
        "dark": {
          "type": "string"
        }
      }
    },
    "homepage": {
      "type": "string"
    },
    "license": {
      "type": "string"
    }
  },
  "additionalProperties": true
}